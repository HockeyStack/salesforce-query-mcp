# Salesforce (MCP server)
SALESFORCE_CID=
SALESFORCE_CS=
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# MCP HTTP server 
# Port the MCP server listens on in HTTP mode
MCP_HTTP_PORT=3001
# Shared secret between MCP server and Slack bot 0 generate with: openssl rand -hex 32
MCP_SECRET_TOKEN=

# Slack bot
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
# Port the Slack bot listens on (nginx proxies /slack/events here)
SLACK_PORT=3000
# Slack user IDs (comma-separated) allowed to invoke write tools, e.g. U01ABC,U02DEF
SLACK_WRITE_ALLOWED_USERS=
# Slack channel ID where writeback actions are audit-logged, e.g. C0XXXXXX for #revops-mcp-writes
SLACK_AUDIT_CHANNEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
# Optional - defaults to claude-opus-4-5
ANTHROPIC_MODEL=claude-opus-4-5

# Slack bot → MCP server
# URL the Slack bot uses to reach the MCP server (localhost since both run on same droplet)
MCP_URL=http://localhost:3001
